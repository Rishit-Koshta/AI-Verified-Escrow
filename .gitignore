# Combined .gitignore for Spring Boot / Maven, Hardhat / Node, FastAPI / Python, and React
# Place this file in the ROOT of the monorepo.

# Secrets and environment files
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
secrets/
**/secrets/

# Java / Spring Boot / Maven
**/target/
**/build/
**/out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
**/application-local.properties
**/application-dev-local.properties
# Keep Maven wrapper scripts and .mvn/wrapper files tracked.

# IntelliJ / Java IDEs
.idea/
*.iml
*.iws
*.ipr

# Node.js / React / Hardhat
**/node_modules/
**/dist/
**/build/
**/.next/
**/.nuxt/
**/.vite/
**/coverage/
**/.nyc_output/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Hardhat generated files
**/artifacts/
**/cache/
**/typechain-types/
**/coverage.json
# Ignore local Hardhat Ignition deployment state
blockchain/ignition/deployments/chain-31337/
blockchain/ignition/deployments/chain-*/

# Python / FastAPI
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.Python
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/htmlcov/
**/site-packages/
**/venv/
**/.venv/
**/env/
**/ENV/
**/pip-wheel-metadata/
**/*.egg-info/
**/wheels/
.python-version

# Logs, temporary files, local databases
*.log
logs/
**/logs/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.sqlite
*.sqlite3
*.db

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# Editor / tooling
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.history/
